# MealSwipe configuration. Copy to .env and adjust. NEVER commit .env.

# --- Application ---
APP_NAME=MealSwipe
# Host port the frontend is published on (docker compose).
APP_PORT=8080

# --- PostgreSQL (required for docker compose) ---
POSTGRES_USER=mealswipe
# REQUIRED: change to a strong unique password, e.g. `openssl rand -hex 24`
POSTGRES_PASSWORD=change_me
POSTGRES_DB=mealswipe
# Host port for dev-only compose.dev.yaml database exposure.
DB_PORT=5432

# --- Backend ---
# Full DSN overrides POSTGRES_* assembly (native/local dev):
# DATABASE_URL=postgres://mealswipe:mealswipe_dev_password@127.0.0.1:5432/mealswipe?sslmode=disable
HTTP_ADDR=:8080
# Set true only when serving over HTTPS (production behind a TLS proxy).
COOKIE_SECURE=false
SESSION_TTL_HOURS=720
SEED_ON_START=true
# Extra allowed Origin headers, comma-separated (usually unneeded: nginx/vite proxy is same-origin).
ALLOWED_ORIGINS=
LOG_LEVEL=info

# --- Optional: TheMealDB importer (backend import-mealdb). Public test key = 1 ---
MEALDB_API_KEY=1

# --- Frontend build ---
VITE_APP_NAME=MealSwipe
